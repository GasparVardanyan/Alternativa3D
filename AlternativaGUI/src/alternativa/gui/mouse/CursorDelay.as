	/**
	 * Список констант времени для хинта.  
	 * 
	 */	
	public final class CursorDelay {
		
		/**
		 * Максимальное время между кликами двойного щелчка в мс. 
		 */		
		internal static const DOUBLE_CLICK_DELAY:int = 150;
		
		/**
		 * Задержка перед показом хинта в мс. 
		 */		
		internal static const SHOW_HINT_DELAY:int = 600;
		
		/**
		 * Время показа хинта в мс. 
		 */		
