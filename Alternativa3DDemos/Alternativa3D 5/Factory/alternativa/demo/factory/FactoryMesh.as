	/**
	 * Factory model.
	 */
	public class FactoryMesh extends Mesh {

		// Low-quality texture
		[Embed(source="factorylow.jpg")] private static const Bmp:Class;
		private static const texture:Texture = new Texture(new Bmp().bitmapData, "factory.jpg");

		// The model's material
		public var material:TextureMaterial = new TextureMaterial(texture, 1, false, true, "normal", -1, 0xFFFFFF);

		// The loader for high resolution texture
		private var loader:Loader;
		// Callback function which is called after texture loading is complete
		private var onLoadMethod:Function;

		/**
		 * The method loads high resolution texture.
		 * 
		 * @param onLoadMethod function which is called after texture loading is complete
		 */
		public function load(onLoadMethod:Function):String {
			this.onLoadMethod = onLoadMethod;
			loader = new Loader();
			loader.contentLoaderInfo.addEventListener(Event.COMPLETE, onLoadComplete);
			loader.contentLoaderInfo.addEventListener(IOErrorEvent.IO_ERROR, onLoadError);
			loader.load(new URLRequest(texture.name));
			return "Loading texture";
		}

		/**
		 * The method handles successful loading of high resolution texture.
		 */
		private function onLoadComplete(e:Event):void {
			try {
				material.texture = new Texture(Bitmap(loader.content).bitmapData);
			} finally {
				complete();
			}
		}

		/**
		 * Loading errors handler.
		 */
		private function onLoadError(e:IOErrorEvent):void {
			complete();
		}

		/**
		 * The method performs cleanup and invokes callback function.
		 */
		private function complete():void {
			loader.contentLoaderInfo.removeEventListener(Event.COMPLETE, onLoadComplete);
			loader.contentLoaderInfo.removeEventListener(IOErrorEvent.IO_ERROR, onLoadError);
			loader = null;
			onLoadMethod.call();
			onLoadMethod = null;
		}

