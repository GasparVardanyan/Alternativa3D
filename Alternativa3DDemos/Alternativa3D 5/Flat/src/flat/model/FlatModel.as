		public function setBestPrecision():void {
			
			var material:TextureMaterial;
			for (var i:int = 0;i<materials.length;i++) {
				material = materials[i] as TextureMaterial;
				material.precision = TextureMaterialPrecision.BEST;
			}
			
		}
		
		public function setLowPrecision():void {
			
			var material:TextureMaterial;
			for (var i:int = 0;i<materials.length;i++) {
				material = materials[i] as TextureMaterial;
				material.precision = TextureMaterialPrecision.LOW;
			}
		}
	}
